# Copy to .env and adjust. Every value is optional; the defaults are shown.

# Web UI port (http://<server>:8090)
WEB_PORT=8090

# HTTPS port for the web UI (0 = off). Browsers only allow the microphone on
# HTTPS pages, which you need for talking to a camera from the web UI. A
# self-signed certificate is generated in the data volume unless you provide
# your own (paths inside the container, e.g. mounted into /data/tls/).
HTTPS_PORT=8443
TLS_CERT=
TLS_KEY=

# Initial admin password for the web UI (at least 10 characters). If empty, the
# UI asks you to choose one on first visit, so set it (or finish the setup)
# before you expose the UI. It is only applied when no password has been set yet.
ADMIN_PASSWORD=

# Local SIP port (UDP) used by all virtual phones. Doesn't need to be 5060.
SIP_PORT=5062

# RTP (audio) port range, UDP. Each call uses one port.
RTP_PORT_MIN=16000
RTP_PORT_MAX=16199

# IP address put in SIP Contact / SDP. Leave empty to auto-detect the address
# of the interface that routes to the PBX. Set it if auto-detection picks the
# wrong interface.
ADVERTISE_IP=

# Secure flag on the session cookie. auto: when a trusted reverse proxy reports
# HTTPS (X-Forwarded-Proto). true: always (HTTPS-only access). false: never.
SECURE_COOKIES=auto

# Reverse proxies allowed to set X-Forwarded-For/-Proto: comma-separated IPs or
# networks, "private" (loopback + private networks) or "none". Login throttling
# uses the client IP they report. Add your proxy if it has a public address.
TRUSTED_PROXIES=private

# Internal ports on 127.0.0.1 (change only on conflicts)
GO2RTC_API_PORT=11984
GO2RTC_RTSP_PORT=18554
TALK_PORT=18555
PIPER_PORT=18556

# Logging: DEBUG / INFO / WARNING. SIP_TRACE=true logs every SIP message.
LOG_LEVEL=INFO
SIP_TRACE=false
GO2RTC_LOG_LEVEL=info
